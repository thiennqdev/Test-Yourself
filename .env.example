# Secret Keys (Optional: Docker compose has default demo keys)
SECRET_KEY=testyourself_super_secret_key_demo_mode_123456789
JWT_SECRET_KEY=testyourself_jwt_secret_key_demo_mode_987654321

# Google OAuth Credentials (Optional: Chỉ cần khi muốn test Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback
